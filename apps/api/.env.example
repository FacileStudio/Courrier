# Required
DATABASE_URL=postgres://postgres:postgres@localhost:5432/courrier?sslmode=disable
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Optional — defaults shown
APP_ENV=development
PORT=4000
LOG_LEVEL=info
STORAGE_DIR=./data
# SSO_ONLY=false

# Path to SvelteKit build output (optional, for unified mode)
# CLIENT_DIR=./client

# CORS origins (optional — needed when the client runs on :5173)
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# OIDC (optional)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=http://localhost:4000/api/auth/oidc/callback
# OIDC_SUCCESS_URL=http://localhost:5173
# OIDC_CLI_AUDIENCE=facile-cli

# Journal log shipping (optional — per-app key from Journal's Keys page).
# The /api suffix is required: the SDK appends /ingest, and Journal mounts that route
# under /api. Without it every POST 404s and nothing ships, silently.
# JOURNAL_URL=http://journal-api:4010/api
# JOURNAL_TOKEN=journal_courrier_...
