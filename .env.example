# Required — 32+ character key for encrypting IMAP/SMTP credentials at rest.
# The API refuses to start without it. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Required — PostgreSQL credentials; docker-compose builds DATABASE_URL from them
POSTGRES_USER=
POSTGRES_PASSWORD=
# POSTGRES_DB=courrier

# Required by the API itself — set only for non-Docker setups
# DATABASE_URL=postgresql://user:pass@localhost:5432/courrier?sslmode=disable

# Optional — defaults shown
# APP_ENV=production
# PORT=4000
# LOG_LEVEL=info
# STORAGE_DIR=/data
# CLIENT_DIR=/client
# SSO_ONLY=false

# CORS origins (optional — only needed if the client is deployed separately from the API)
# CORS_ALLOWED_ORIGINS=https://courrier.yourdomain.com

# OIDC (optional — enable to use Authentik or any OpenID Connect provider)
# OIDC_ISSUER=https://authentik.yourdomain.com/application/o/courrier/
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URL=https://courrier.yourdomain.com/api/auth/oidc/callback
# OIDC_SUCCESS_URL=https://courrier.yourdomain.com

# Journal log shipping (optional — per-app key from Journal's Keys page; internal URL http://journal-api:4010 on la ruche)
# JOURNAL_URL=http://journal-api:4010
# JOURNAL_TOKEN=journal_courrier_...
